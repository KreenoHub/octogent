{
  "name": "@octogent/octoplan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "start": "tsx server/main.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
